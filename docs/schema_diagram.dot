// Relational schema diagram, generated to match db/postgres/01_schema.sql.
// Render: dot -Tpng docs/schema_diagram.dot -o docs/schema_diagram.png
// Arrows go from a foreign key to the primary key it references; the label is its ON DELETE rule.
digraph schema {
  rankdir=LR; nodesep=0.5; ranksep=1.6; splines=true; bgcolor=white; pad=0.3; dpi=150;
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans Bold", fontsize=10, arrowsize=0.8, penwidth=1.4];
  users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#333333"><tr><td colspan="3" bgcolor="#e3f1e5"><b>users</b></td></tr><tr><td align="left" port="user_id"><u>user_id</u></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left" port="user_id_r"><font color="#555555">PK</font></td></tr><tr><td align="left" port="username">username</td><td align="left"><font color="#555555">VARCHAR(30)</font></td><td align="left" port="username_r"><font color="#555555">UQ</font></td></tr><tr><td align="left" port="email">email</td><td align="left"><font color="#555555">VARCHAR(255)</font></td><td align="left" port="email_r"><font color="#555555">UQ</font></td></tr><tr><td align="left" port="password_hash">password_hash</td><td align="left"><font color="#555555">TEXT</font></td><td align="left" port="password_hash_r">&#160;&#160;</td></tr><tr><td align="left" port="role">role</td><td align="left"><font color="#555555">VARCHAR(12)</font></td><td align="left" port="role_r">&#160;&#160;</td></tr><tr><td align="left" port="global_rating">global_rating</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="global_rating_r">&#160;&#160;</td></tr><tr><td align="left" port="global_rank">global_rank</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="global_rank_r">&#160;&#160;</td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left" port="created_at_r">&#160;&#160;</td></tr></table>>];
  problems [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#333333"><tr><td colspan="3" bgcolor="#e3f1e5"><b>problems</b></td></tr><tr><td align="left" port="problem_id"><u>problem_id</u></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left" port="problem_id_r"><font color="#555555">PK</font></td></tr><tr><td align="left" port="author_id">author_id</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="author_id_r"><font color="#555555">FK</font></td></tr><tr><td align="left" port="title">title</td><td align="left"><font color="#555555">VARCHAR(150)</font></td><td align="left" port="title_r"><font color="#555555">UQ</font></td></tr><tr><td align="left" port="statement">statement</td><td align="left"><font color="#555555">TEXT</font></td><td align="left" port="statement_r">&#160;&#160;</td></tr><tr><td align="left" port="difficulty">difficulty</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="difficulty_r">&#160;&#160;</td></tr><tr><td align="left" port="time_limit_ms">time_limit_ms</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="time_limit_ms_r">&#160;&#160;</td></tr><tr><td align="left" port="memory_limit_kb">memory_limit_kb</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="memory_limit_kb_r">&#160;&#160;</td></tr><tr><td align="left" port="embedding">embedding</td><td align="left"><font color="#555555">VECTOR(384)</font></td><td align="left" port="embedding_r">&#160;&#160;</td></tr><tr><td align="left" port="search_tsv">search_tsv</td><td align="left"><font color="#555555">TSVECTOR</font></td><td align="left" port="search_tsv_r"><font color="#555555">GEN</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left" port="created_at_r">&#160;&#160;</td></tr></table>>];
  contests [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#333333"><tr><td colspan="3" bgcolor="#e3f1e5"><b>contests</b></td></tr><tr><td align="left" port="contest_id"><u>contest_id</u></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left" port="contest_id_r"><font color="#555555">PK</font></td></tr><tr><td align="left" port="organizer_id">organizer_id</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="organizer_id_r"><font color="#555555">FK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#555555">VARCHAR(150)</font></td><td align="left" port="name_r"><font color="#555555">UQ</font></td></tr><tr><td align="left" port="start_time">start_time</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left" port="start_time_r">&#160;&#160;</td></tr><tr><td align="left" port="end_time">end_time</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left" port="end_time_r">&#160;&#160;</td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#555555">VARCHAR(10)</font></td><td align="left" port="status_r">&#160;&#160;</td></tr><tr><td align="left" port="ratings_applied">ratings_applied</td><td align="left"><font color="#555555">BOOLEAN</font></td><td align="left" port="ratings_applied_r">&#160;&#160;</td></tr></table>>];
  contest_problems [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#333333"><tr><td colspan="3" bgcolor="#fdf3dc"><b>contest_problems</b></td></tr><tr><td align="left" port="contest_id"><u>contest_id</u></td><td align="left"><font color="#555555">INT</font></td><td align="left" port="contest_id_r"><font color="#555555">PK, FK</font></td></tr><tr><td align="left" port="problem_id"><u>problem_id</u></td><td align="left"><font color="#555555">INT</font></td><td align="left" port="problem_id_r"><font color="#555555">PK, FK</font></td></tr><tr><td align="left" port="points">points</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="points_r">&#160;&#160;</td></tr><tr><td align="left" port="position">position</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="position_r">&#160;&#160;</td></tr></table>>];
  contest_registrations [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#333333"><tr><td colspan="3" bgcolor="#fdf3dc"><b>contest_registrations</b></td></tr><tr><td align="left" port="contest_id"><u>contest_id</u></td><td align="left"><font color="#555555">INT</font></td><td align="left" port="contest_id_r"><font color="#555555">PK, FK</font></td></tr><tr><td align="left" port="user_id"><u>user_id</u></td><td align="left"><font color="#555555">INT</font></td><td align="left" port="user_id_r"><font color="#555555">PK, FK</font></td></tr><tr><td align="left" port="registered_at">registered_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left" port="registered_at_r">&#160;&#160;</td></tr></table>>];
  submissions [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#333333"><tr><td colspan="3" bgcolor="#e3f1e5"><b>submissions</b></td></tr><tr><td align="left" port="submission_id"><u>submission_id</u></td><td align="left"><font color="#555555">BIGSERIAL</font></td><td align="left" port="submission_id_r"><font color="#555555">PK</font></td></tr><tr><td align="left" port="user_id">user_id</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="user_id_r"><font color="#555555">FK</font></td></tr><tr><td align="left" port="problem_id">problem_id</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="problem_id_r"><font color="#555555">FK</font></td></tr><tr><td align="left" port="contest_id">contest_id</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="contest_id_r"><font color="#555555">FK, NULL</font></td></tr><tr><td align="left" port="language">language</td><td align="left"><font color="#555555">VARCHAR(20)</font></td><td align="left" port="language_r">&#160;&#160;</td></tr><tr><td align="left" port="code">code</td><td align="left"><font color="#555555">TEXT</font></td><td align="left" port="code_r">&#160;&#160;</td></tr><tr><td align="left" port="verdict">verdict</td><td align="left"><font color="#555555">VARCHAR(10)</font></td><td align="left" port="verdict_r">&#160;&#160;</td></tr><tr><td align="left" port="runtime_ms">runtime_ms</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="runtime_ms_r">&#160;&#160;</td></tr><tr><td align="left" port="memory_kb">memory_kb</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="memory_kb_r">&#160;&#160;</td></tr><tr><td align="left" port="submitted_at">submitted_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left" port="submitted_at_r">&#160;&#160;</td></tr></table>>];
  ratings_history [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#333333"><tr><td colspan="3" bgcolor="#e3f1e5"><b>ratings_history</b></td></tr><tr><td align="left" port="rating_id"><u>rating_id</u></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left" port="rating_id_r"><font color="#555555">PK</font></td></tr><tr><td align="left" port="user_id">user_id</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="user_id_r"><font color="#555555">FK</font></td></tr><tr><td align="left" port="contest_id">contest_id</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="contest_id_r"><font color="#555555">FK</font></td></tr><tr><td align="left" port="old_rating">old_rating</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="old_rating_r">&#160;&#160;</td></tr><tr><td align="left" port="new_rating">new_rating</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="new_rating_r">&#160;&#160;</td></tr><tr><td align="left" port="changed_at">changed_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left" port="changed_at_r">&#160;&#160;</td></tr></table>>];
  problems:author_id_r:e -> users:user_id:w [label="RESTRICT", color="#c62828", fontcolor="#c62828"];
  contests:organizer_id_r:e -> users:user_id:w [label="RESTRICT", color="#c62828", fontcolor="#c62828"];
  contest_problems:contest_id_r:e -> contests:contest_id:w [label="CASCADE", color="#2e7d32", fontcolor="#2e7d32"];
  contest_problems:problem_id_r:e -> problems:problem_id:w [label="RESTRICT", color="#c62828", fontcolor="#c62828"];
  contest_registrations:contest_id_r:e -> contests:contest_id:w [label="CASCADE", color="#2e7d32", fontcolor="#2e7d32"];
  contest_registrations:user_id_r:e -> users:user_id:w [label="CASCADE", color="#2e7d32", fontcolor="#2e7d32"];
  submissions:user_id_r:e -> users:user_id:w [label="CASCADE", color="#2e7d32", fontcolor="#2e7d32"];
  submissions:problem_id_r:e -> problems:problem_id:w [label="RESTRICT", color="#c62828", fontcolor="#c62828"];
  submissions:contest_id_r:e -> contests:contest_id:w [label="SET NULL", color="#e08a00", fontcolor="#e08a00"];
  ratings_history:user_id_r:e -> users:user_id:w [label="CASCADE", color="#2e7d32", fontcolor="#2e7d32"];
  ratings_history:contest_id_r:e -> contests:contest_id:w [label="CASCADE", color="#2e7d32", fontcolor="#2e7d32"];
  legend [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#999999"><tr><td align="left" colspan="2"><b>Legend</b></td></tr><tr><td align="left"><u>underlined</u></td><td align="left">primary key</td></tr><tr><td align="left">PK, FK</td><td align="left">composite key of a junction table (M:N)</td></tr><tr><td align="left">FK, NULL</td><td align="left">optional link (practice submission)</td></tr><tr><td align="left">GEN</td><td align="left">generated column</td></tr><tr><td align="left"><font color="#2e7d32"><b>CASCADE</b></font></td><td align="left">child rows deleted too</td></tr><tr><td align="left"><font color="#c62828"><b>RESTRICT</b></font></td><td align="left">delete refused while children exist</td></tr><tr><td align="left"><font color="#e08a00"><b>SET NULL</b></font></td><td align="left">link cleared, child row kept</td></tr></table>>];
}
