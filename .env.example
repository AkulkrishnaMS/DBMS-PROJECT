# copy to .env and change the values (never commit .env)
PG_USER=judge_admin
PG_PASSWORD=change_me_pg
PG_DB=judgedb
MONGO_USER=judge_mongo
MONGO_PASSWORD=change_me_mongo
MONGO_DB=judge

# --- used by the Next.js app (not by docker compose) ---
PG_HOST=localhost
PG_PORT=5433
MONGO_HOST=localhost
MONGO_PORT=27017
JWT_SECRET=change_me_to_a_long_random_string

# Judge0 (optional, not working on cgroup v2 hosts)
JUDGE0_DB_PASSWORD=change_me_j0db
JUDGE0_REDIS_PASSWORD=change_me_j0redis
JUDGE0_SECRET_KEY_BASE=change_me_long_random_string
